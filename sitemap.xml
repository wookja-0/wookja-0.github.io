---
layout: null
sitemap: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url | remove: 'index.html' }}</loc>
    {% if post.last_modified_at %}
    <lastmod>{{ post.last_modified_at | date: '%Y-%m-%d' }}</lastmod>
    {% elsif post.lastmod %}
    <lastmod>{{ post.lastmod | date: '%Y-%m-%d' }}</lastmod>
    {% elsif post.date %}
    <lastmod>{{ post.date | date: '%Y-%m-%d' }}</lastmod>
    {% endif %}
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}

  {% for page in site.pages %}
  {% unless page.sitemap == false %}
  {% if page.layout != nil and page.layout != 'feed' %}
  <url>
    <loc>{{ site.url }}{{ page.url | remove: 'index.html' }}</loc>
    {% if page.lastmod %}
    <lastmod>{{ page.lastmod | date: '%Y-%m-%d' }}</lastmod>
    {% endif %}
    <changefreq>yearly</changefreq>
    <priority>{{ page.priority | default: 0.5 }}</priority>
  </url>
  {% endif %}
  {% endunless %}
  {% endfor %}

  {% for tab in site.tabs %}
  <url>
    <loc>{{ site.url }}{{ tab.url | remove: 'index.html' }}</loc>
    {% if tab.lastmod %}
    <lastmod>{{ tab.lastmod | date: '%Y-%m-%d' }}</lastmod>
    {% endif %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}

  {% for tag in site.tags %}
  <url>
    <loc>{{ site.url }}/tags/{{ tag[0] | slugify }}/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  {% endfor %}

  {% for category in site.categories %}
  <url>
    <loc>{{ site.url }}/categories/{{ category[0] | slugify }}/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  {% endfor %}
</urlset>
